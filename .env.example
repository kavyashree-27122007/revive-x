# ============================================================
# REVIVE X — Environment Variables
# Copy this file to .env and fill in values
# ============================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB (required for full persistence; app uses in-memory fallback if absent)
MONGODB_URI=mongodb://localhost:27017/revivex

# ============================================================
# Razorpay Test Mode (OPTIONAL)
# If not provided, app runs in MOCK MODE automatically
# NEVER use production credentials here
# ============================================================
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

# ============================================================
# AI Provider (OPTIONAL)
# If not provided, deterministic fallback engine is used
# ============================================================
GEMINI_API_KEY=xxxx
